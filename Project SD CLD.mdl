{UTF-8}
Attrition Rate  = A FUNCTION OF( Rider Workforce)
	~	
	~		|

Capacity Utilization  = A FUNCTION OF( Order Fulfillment Rate)
	~	
	~		|

Delivery Capacity  = A FUNCTION OF( Rider Workforce)
	~	
	~		|

Delivery Delay  = A FUNCTION OF( Capacity Utilization,Order Backlog)
	~	
	~		|

Desired Workforce  = A FUNCTION OF( Order Backlog)
	~	
	~		|

Hiring Rate  = A FUNCTION OF( Desired Workforce)
	~	
	~		|

Inventory Gap  = A FUNCTION OF( Inventory Level)
	~	
	~		|

Inventory Level  = A FUNCTION OF( Order Fulfillment Rate,Replenishment Rate)
	~	
	~		|

Order Arrival Rate  = A FUNCTION OF( Service Level)
	~	
	~		|

Order Backlog  = A FUNCTION OF( Order Arrival Rate,Order Fulfillment Rate)
	~	
	~		|

Order Fulfillment Rate  = A FUNCTION OF( Delivery Capacity,Inventory Level)
	~	
	~		|

Replenishment Rate  = A FUNCTION OF( Inventory Gap)
	~	
	~		|

Rider Workforce  = A FUNCTION OF( Attrition Rate,Hiring Rate)
	~	
	~		|

Service Level  = A FUNCTION OF( Delivery Delay)
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 100
	~	Hour
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Hour
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Hour [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.125
	~	Hour [0,?]
	~	The time step for the simulation.
	|

