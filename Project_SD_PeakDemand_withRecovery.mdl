{UTF-8}
Attrition fraction=0.05
	~	1/Hour
	~		|

Attrition Rate=Rider workforce*Attrition fraction
	~	riders/Hour
	~		|

Base Delay=1
	~	Hour
	~		|

Base demand=25 + STEP(10,10) + STEP(10,20) - STEP(15,40)
	~	orders/Hour
	~		|

Capacity utilization=Order fulfilment rate/Delivery capacity
	~	Dmnl
	~		|

Delivery capacity=Rider workforce*Productivity
	~	orders/Hour
	~		|

Delivery delay=Base Delay*(1+(Capacity utilization)^2)
	~	Hour
	~		|

Desired workforce=Order Backlog/(Target Delay*Productivity)
	~	riders
	~		|

Dispatch rate=Order fulfilment rate
	~	orders/Hour
	~		|

Hiring rate=(Desired workforce-Rider workforce)/Workforce ajustment time
	~	riders/Hour
	~		|

Inventory gap=Target Inventory-Inventory Level
	~	orders
	~		|

Inventory Lead Time=4
	~	Hour
	~		|

Inventory Level= INTEG (Replenishment rate-Dispatch rate,
		200)
	~	orders
	~		|

Inventroy Clearance Time=1
	~	Hour
	~		|

Order arrival rate=Base demand*Service level
	~	orders/Hour
	~		|

Order Backlog= INTEG (Order arrival rate-Order fulfilment rate,
		50)
	~	orders
	~		|

order Clearance time=1
	~	Hour
	~		|

Order fulfilment rate=MIN(MIN(Order Backlog/order Clearance time, Inventory Level/Inventroy Clearance Time\
		), Delivery capacity)
	~	orders/Hour
	~		|

Productivity=3
	~	orders/(riders*Hour)
	~		|

Replenishment rate=Inventory gap/Inventory Lead Time
	~	orders/Hour
	~		|

Rider workforce= INTEG (Hiring rate-Attrition Rate,
		20)
	~	riders
	~		|

Service level=Target Delay/Delivery delay
	~	Dmnl
	~		|

Target Delay=1.5
	~	Hour
	~		|

Target Inventory=250
	~	orders
	~		|

Workforce ajustment time=5
	~	Hour
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 100
	~	Hour
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Hour
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Hour [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.125
	~	Hour [0,?]
	~	The time step for the simulation.
	|

